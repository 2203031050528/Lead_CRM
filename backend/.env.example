# Copy to .env and adjust. Never commit .env.
# On servers this file lives at /etc/crm/crm.env and is found via DJANGO_ENV_FILE (see deploy/).
# The settings module comes from the process environment, not this file:
# manage.py defaults to config.settings.dev, wsgi.py (Gunicorn) to config.settings.prod.
SECRET_KEY=change-me
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Timezone for times in reminder emails, e.g. Asia/Kolkata
TIME_ZONE=UTC

# Email (Amazon SES SMTP in production)
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CRM <no-reply@example.com>

# S3
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=
AWS_BACKUP_BUCKET_NAME=
# Optional, for S3-compatible storage in development (MinIO): http://localhost:9000
AWS_S3_ENDPOINT_URL=
# Leave keys empty on EC2 to use the instance IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tests always use this (never DATABASE_URL). Defaults to local Postgres.
# TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Backups (manage.py backup_db): pg_dump binary (same major version as the server or newer)
PG_DUMP_PATH=pg_dump
BACKUP_PREFIX=backups
