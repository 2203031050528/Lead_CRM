[Unit]
Description=Lead CRM (Gunicorn, 2 sync workers)
Requires=gunicorn.socket
After=network.target postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=crm
Group=crm
WorkingDirectory=/srv/crm/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=DJANGO_ENV_FILE=/etc/crm/crm.env
# 2 sync workers fit the 1 GB instance. Workers are recycled every ~500 requests so slow leaks
# can't accumulate; a 30s timeout bounds the slowest request (5,000-row CSV import).
ExecStart=/srv/crm/venv/bin/gunicorn config.wsgi:application \
    --workers 2 --worker-class sync --timeout 30 --graceful-timeout 20 \
    --max-requests 500 --max-requests-jitter 50 \
    --access-logfile - --error-logfile - --log-level info
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=25
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
# Soft ceiling: the kernel reclaims (swaps) above this instead of letting Gunicorn starve Postgres.
MemoryHigh=450M

[Install]
WantedBy=multi-user.target
